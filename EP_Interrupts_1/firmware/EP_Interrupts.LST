 161          BOOL DR_VendorCmnd(void)
 162          {
 163   1        BYTE tmp;
 164   1        
 165   1        switch (SETUPDAT[1])
 166   1        {
 167   2           case VR_NAKALL_ON:
 168   2              tmp = FIFORESET;
 169   2              tmp |= bmNAKALL;      
 170   2              SYNCDELAY;                    
 171   2              FIFORESET = tmp;
 172   2              break;
 173   2           case VR_NAKALL_OFF:
 174   2              tmp = FIFORESET;
 175   2              tmp &= ~bmNAKALL;      
 176   2              SYNCDELAY;                    
 177   2              FIFORESET = tmp;
 178   2              break;
