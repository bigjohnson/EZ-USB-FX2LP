 283          void ISR_Ep2inout(void) interrupt 0
 284          {
 285   1         WORD count;
 286   1         WORD  i;
 287   1      
 288   1         if(!(EP2468STAT & bmEP6FULL))
 289   1         {  // check EP6 FULL(busy) bit in EP2468STAT (SFR), core set's this bit when FIFO is full
