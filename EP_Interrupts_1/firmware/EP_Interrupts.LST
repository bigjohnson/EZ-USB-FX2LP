 291   2            APTR1L = LSB( &EP2FIFOBUF );
 292   2            
 293   2            AUTOPTRH2 = MSB( &EP6FIFOBUF );
 294   2            AUTOPTRL2 = LSB( &EP6FIFOBUF );
 295   2            
 296   2            count = (EP2BCH << 8) + EP2BCL;
 297   2            
 298   2            // loop EP2OUT buffer data to EP6IN
 299   2            for( i = 0x0000; i < count; i++ )
 300   2            {
 301   3               // setup to transfer EP2OUT buffer to EP6IN buffer using AUTOPOINTER(s)
 302   3               EXTAUTODAT2 = EXTAUTODAT1;
