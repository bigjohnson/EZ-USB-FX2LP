 154          BOOL DR_VendorCmnd(void) {
 155   1        BYTE tmp;
 156   1      
 157   1        switch (SETUPDAT[1]) {
 158   2        case VR_NAKALL_ON:
 159   2          tmp = FIFORESET;
 160   2          tmp |= bmNAKALL;
 161   2          SYNCDELAY;
 162   2          FIFORESET = tmp;
 163   2          break;
 164   2        case VR_NAKALL_OFF:
 165   2          tmp = FIFORESET;
 166   2          tmp &= ~bmNAKALL;
 167   2          SYNCDELAY;
 168   2          FIFORESET = tmp;
 169   2          break;
 170   2        default:
 171   2          return(TRUE);
 172   2        }
 173   1      
 174   1        return(FALSE);
 175   1      }
