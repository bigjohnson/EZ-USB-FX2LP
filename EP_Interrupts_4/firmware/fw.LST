 230          BOOL HighSpeedCapable() {
 231   1        // this function determines if the chip is high-speed capable.
 232   1        // FX2 and FX2LP are high-speed capable. FX1 is not - it does
 233   1        // not have a high-speed transceiver.
 234   1      
 235   1        if (GPCR2 & bmFULLSPEEDONLY)
 236   1          return FALSE;
 237   1        else
 238   1          return TRUE;
 239   1      }
