 150   1      
 151   1        USBIE |= bmSUDAV | bmSUTOK | bmSUSP | bmURES | bmHSGRANT;   // Enable selected interrupts
 152   1        EA = 1;                  // Enable 8051 interrupts
 153   1      
 154   1      #ifndef NO_RENUM
