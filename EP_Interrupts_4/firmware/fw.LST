 108   1      
 109   1        // The following section of code is used to relocate the descriptor table.
 110   1        // The frameworks uses SUDPTRH and SUDPTRL to automate the SETUP requests
 111   1        // for descriptors.  These registers only work with memory locations
 112   1        // in the EZ-USB internal RAM.  Therefore, if the descriptors are located
 113   1        // in external RAM, they must be copied to in internal RAM.
 114   1        // The descriptor table is relocated by the frameworks ONLY if it is found
 115   1        // to be located in external memory.
 116   1        pDeviceDscr = (WORD)&DeviceDscr;
C51 COMPILER V9.60.7.0   FW                                                                10/03/2026 20:44:46 PAGE 3   

 117   1        pDeviceQualDscr = (WORD)&DeviceQualDscr;
