 241          // Device request parser
 242          void SetupCommand(void) {
 243   1        void   *dscr_ptr;
 244   1      
 245   1        switch(SETUPDAT[1]) {
 246   2        case SC_GET_DESCRIPTOR:                  // *** Get Descriptor
 247   2          if(DR_GetDescriptor())
 248   2            switch(SETUPDAT[3]) {
 249   3            case GD_DEVICE:            // Device
 250   3              SUDPTRH = MSB(pDeviceDscr);
 251   3              SUDPTRL = LSB(pDeviceDscr);
 252   3              break;
 253   3            case GD_DEVICE_QUALIFIER:            // Device Qualifier
 254   3              // only retuen a device qualifier if this is a high speed
 255   3              // capable chip.
 256   3              if (HighSpeedCapable()) {
 257   4                SUDPTRH = MSB(pDeviceQualDscr);
 258   4                SUDPTRL = LSB(pDeviceQualDscr);
 259   4              } else {
 260   4                EZUSB_STALL_EP0();
 261   4              }
 262   3              break;
 263   3            case GD_CONFIGURATION:         // Configuration
 264   3              SUDPTRH = MSB(pConfigDscr);
 265   3              SUDPTRL = LSB(pConfigDscr);
 266   3              break;
 267   3            case GD_OTHER_SPEED_CONFIGURATION:  // Other Speed Configuration
 268   3              SUDPTRH = MSB(pOtherConfigDscr);
 269   3              SUDPTRL = LSB(pOtherConfigDscr);
 270   3              break;
 271   3            case GD_STRING:            // String
 272   3              if(dscr_ptr = (void *)EZUSB_GetStringDscr(SETUPDAT[2])) {
 273   4                SUDPTRH = MSB(dscr_ptr);
 274   4                SUDPTRL = LSB(dscr_ptr);
 275   4              } else
 276   3                EZUSB_STALL_EP0();   // Stall End Point 0
 277   3              break;
 278   3            default:            // Invalid request
 279   3              EZUSB_STALL_EP0();      // Stall End Point 0
 280   3            }
 281   2          break;
 282   2        case SC_GET_INTERFACE:                  // *** Get Interface
 283   2          DR_GetInterface();
 284   2          break;
 285   2        case SC_SET_INTERFACE:                  // *** Set Interface
 286   2          DR_SetInterface();
 287   2          break;
 288   2        case SC_SET_CONFIGURATION:               // *** Set Configuration
 289   2          DR_SetConfiguration();
 290   2          break;
 291   2        case SC_GET_CONFIGURATION:               // *** Get Configuration
 292   2          DR_GetConfiguration();
 293   2          break;
 294   2        case SC_GET_STATUS:                  // *** Get Status
 295   2          if(DR_GetStatus())
 296   2            switch(SETUPDAT[0]) {
 297   3            case GS_DEVICE:            // Device
 298   3              EP0BUF[0] = ((BYTE)Rwuen << 1) | (BYTE)Selfpwr;
 299   3              EP0BUF[1] = 0;
 300   3              EP0BCH = 0;
 301   3              EP0BCL = 2;
C51 COMPILER V9.60.7.0   FW                                                                10/03/2026 20:44:46 PAGE 6   

 302   3              break;
 303   3            case GS_INTERFACE:         // Interface
 304   3              EP0BUF[0] = 0;
 305   3              EP0BUF[1] = 0;
 306   3              EP0BCH = 0;
 307   3              EP0BCL = 2;
 308   3              break;
 309   3            case GS_ENDPOINT:         // End Point
 310   3              EP0BUF[0] = *(BYTE xdata *) epcs(SETUPDAT[4]) & bmEPSTALL;
 311   3              EP0BUF[1] = 0;
 312   3              EP0BCH = 0;
 313   3              EP0BCL = 2;
 314   3              break;
 315   3            default:            // Invalid Command
 316   3              EZUSB_STALL_EP0();      // Stall End Point 0
 317   3            }
 318   2          break;
 319   2        case SC_CLEAR_FEATURE:                  // *** Clear Feature
 320   2          if(DR_ClearFeature())
 321   2            switch(SETUPDAT[0]) {
 322   3            case FT_DEVICE:            // Device
 323   3              if(SETUPDAT[2] == 1)
 324   3                Rwuen = FALSE;       // Disable Remote Wakeup
 325   3              else
 326   3                EZUSB_STALL_EP0();   // Stall End Point 0
 327   3              break;
 328   3            case FT_ENDPOINT:         // End Point
 329   3              if(SETUPDAT[2] == 0) {
 330   4                *(BYTE xdata *) epcs(SETUPDAT[4]) &= ~bmEPSTALL;
 331   4                EZUSB_RESET_DATA_TOGGLE( SETUPDAT[4] );
 332   4              } else
 333   3                EZUSB_STALL_EP0();   // Stall End Point 0
 334   3              break;
 335   3            }
 336   2          break;
 337   2        case SC_SET_FEATURE:                  // *** Set Feature
 338   2          if(DR_SetFeature())
 339   2            switch(SETUPDAT[0]) {
 340   3            case FT_DEVICE:            // Device
 341   3              if(SETUPDAT[2] == 1)
 342   3                Rwuen = TRUE;      // Enable Remote Wakeup
 343   3              else if(SETUPDAT[2] == 2)
 344   3                // Set Feature Test Mode.  The core handles this request.  However, it is
 345   3                // necessary for the firmware to complete the handshake phase of the
 346   3                // control transfer before the chip will enter test mode.  It is also
 347   3                // necessary for FX2 to be physically disconnected (D+ and D-)
 348   3                // from the host before it will enter test mode.
 349   3                break;
 350   3              else
 351   3                EZUSB_STALL_EP0();   // Stall End Point 0
 352   3              break;
 353   3            case FT_ENDPOINT:         // End Point
 354   3              *(BYTE xdata *) epcs(SETUPDAT[4]) |= bmEPSTALL;
 355   3              break;
 356   3            default:
 357   3              EZUSB_STALL_EP0();      // Stall End Point 0
 358   3            }
 359   2          break;
 360   2        default:                     // *** Invalid Command
 361   2          if(DR_VendorCmnd())
 362   2            EZUSB_STALL_EP0();            // Stall End Point 0
 363   2        }
C51 COMPILER V9.60.7.0   FW                                                                10/03/2026 20:44:46 PAGE 7   

 364   1      
 365   1        // Acknowledge handshake phase of device request
 366   1        EP0CS |= bmHSNAK;
 367   1      }
