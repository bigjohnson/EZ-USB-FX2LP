 182   3          }
 183   2      
 184   2          // check for and handle suspend.
 185   2          // NOTE: Idle mode stops the processor clock.  There are only two
 186   2          // ways out of idle mode, the WAKEUP pin, and detection of the USB
 187   2          // resume state on the USB bus.  The timers will stop and the
 188   2          // processor will not wake up on any other interrupts.
 189   2          if (Sleep) {
 190   3            if(TD_Suspend()) {
 191   4              Sleep = FALSE;     // Clear the "go to sleep" flag.  Do it here to prevent any race condition between 
             -wakeup and the next sleep.
 192   4              do {
 193   5                EZUSB_Susp();         // Place processor in idle mode.
 194   5              } while(!Rwuen && EZUSB_EXTWAKEUP());
 195   4              // above.  Must continue to go back into suspend if the host has disabled remote wakeup
 196   4              // *and* the wakeup was caused by the external wakeup pin.
 197   4      
 198   4              // 8051 activity will resume here due to USB bus or Wakeup# pin activity.
 199   4              EZUSB_Resume();   // If source is the Wakeup# pin, signal the host to Resume.
 200   4              TD_Resume();
