 166          BOOL DR_VendorCmnd(void)
 167          {
 168   1        BYTE tmp;
 169   1        
 170   1        switch (SETUPDAT[1])
 171   1        {
 172   2           case VR_NAKALL_ON:
 173   2              tmp = FIFORESET;
 174   2              tmp |= bmNAKALL;      
 175   2              SYNCDELAY;                    
 176   2              FIFORESET = tmp;
C51 COMPILER V7.20   EP_INTERRUPTS                                                         01/26/2024 23:40:16 PAGE 4   

 177   2              break;
 178   2           case VR_NAKALL_OFF:
 179   2              tmp = FIFORESET;
 180   2              tmp &= ~bmNAKALL;      
 181   2              SYNCDELAY;                    
 182   2              FIFORESET = tmp;
 183   2              break;
 184   2           default:
 185   2              return(TRUE);
 186   2        }
 187   1      
 188   1        return(FALSE);
 189   1      }
