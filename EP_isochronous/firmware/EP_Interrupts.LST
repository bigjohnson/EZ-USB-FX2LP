  28          void TD_Init(void)             // Called once at startup
  29          {
  30   1         // set the CPU clock to 48MHz
  31   1         CPUCS = ((CPUCS & ~bmCLKSPD) | bmCLKSPD1) ;
  32   1      
  33   1         // set the slave FIFO interface to 48MHz
  34   1         IFCONFIG |= 0x40;
